{
  "name": "agent-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-browser": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run test/unit",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run test/integration --passWithNoTests",
    "precoverage": "npm run build",
    "coverage": "vitest run test/unit test/integration --coverage"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "playwright-extra": "4.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
